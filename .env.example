# ============================

# Django

# ============================

DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================

# PostgreSQL

# ============================

POSTGRES_DB=dockforge_db
POSTGRES_USER=dockforge_user
POSTGRES_PASSWORD=dockforge_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================

# Redis

# ============================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------
# AI Layer (Chapter 11)
# ---------------------------------------------------------------------

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3